# ─────────────────────────────────────────────────────────────────────────────
#  PULSE — environment configuration. Copy to .env (or run `npm run setup`).
#  Everything is optional: with no keys PULSE runs on keyless live sources, and every
#  feature without a free source shows a labelled demo or "connect a provider" state.
#  All keys are read server-side only. Nothing here reaches the browser except NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# live (default) | mock  — mock simulates every market stream (offline demo; news stays real)
PULSE_MODE=live
# Home time zone for briefs and schedules (can also be changed in Settings → Time zones)
# PULSE_TZ=America/New_York
# Public URL of this deployment (used in email links and the ICS feed URL)
# PUBLIC_URL=https://pulse.example.com
# Encryption key for integration credentials (otherwise data/secret.key is generated, chmod 600)
# PULSE_SECRET=change-me-to-a-long-random-string

# ── Market data providers (auto = keyless live, or a keyed provider if its key is set) ──
# CRYPTO_PROVIDER=auto          # coinbase | binance | binanceus | mock
# EQUITY_PROVIDER=auto          # alpaca | finnhub | stooq | mock
# FX_PROVIDER=auto              # twelvedata | finnhub | stooq | mock
# MACRO_PROVIDER=auto           # stooq | mock   (indices, commodities, yields, DXY — delayed)
# NEWS_PROVIDERS=auto           # rss,finnhub,cryptopanic
# CALENDAR_PROVIDER=auto        # forexfactory | mock
# EARNINGS_PROVIDER=auto        # finnhub | nasdaq | mock
# CRYPTO_MARKET_PROVIDER=auto   # public | mock
# VOL_PROVIDER=auto             # cboe | mock
# OPTIONS_PROVIDER=auto         # cboe | mock

# ── Keys (all free tiers unless noted) ────────────────────────────────────────
FINNHUB_API_KEY=                # finnhub.io — 60 req/min; real-time US trades, news, earnings
TWELVEDATA_API_KEY=             # twelvedata.com — 8 credits/min, 800/day
ALPACA_API_KEY_ID=              # alpaca.markets — IEX trades; also read-only positions import
ALPACA_API_SECRET_KEY=
# ALPACA_LIVE=1                 # positions from the live account (default: paper)
FRED_API_KEY=                   # fred.stlouisfed.org — real yields & breakevens (daily), 120 req/min
CRYPTOPANIC_API_KEY=            # paid since 2026
# CFTC_APP_TOKEN=               # optional Socrata app token (higher COT rate limits)
# RATEPATH_URL=                 # optional JSON endpoint returning RatePath[] from your futures/OIS vendor
# Required by SEC EDGAR fair-access policy (name + email):
SEC_USER_AGENT=PulseTerminal you@example.com

# ── AI (optional) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=              # console.anthropic.com — TL;DRs, brief narrative, Ask Pulse, themes, filings, smart alerts
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_SMALL_MODEL=claude-haiku-4-5   # classification / labels / parsing
# AI_DAILY_TOKEN_BUDGET=300000  # hard daily cap across every AI feature (editable in Settings → AI)
# AI_MIN_IMPACT=50
# AI_MAX_PER_HOUR=40

# ── Delivery & notifications ──────────────────────────────────────────────────
# Email/Slack/Telegram/Discord/Twilio/Notion/webhooks/calendar are connected in Settings → Integrations
# (credentials are stored encrypted on the server, not in this file).
# VAPID_SUBJECT=mailto:you@example.com          # web push contact
# ELEVENLABS_API_KEY=                            # optional server TTS for Listen mode
# ELEVENLABS_VOICE_ID=
# PULSE_INTEGRATIONS_DISABLED=sms,notion          # feature-flag integrations off

# ── Retention ─────────────────────────────────────────────────────────────────
# NEWS_RETENTION_DAYS=7
# BRIEF_RETENTION_DAYS=400
# REPLAY_RETENTION_DAYS=30      # tick archive (raw → 1s after 1 day → 1m after 7 days)
# BREAKING_THRESHOLD=75
# RSS_POLL_SECONDS=60

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=3000
# DATABASE_PATH=./data/pulse.db
# CORS_ORIGIN=*
