# ─────────────────────────────────────────────────────────────────────────────
#  PULSE — environment configuration
#  Copy to .env. Everything is optional: with no keys the app runs fully in mock mode.
#  All keys are read by the worker only (server-side). Nothing here is sent to the browser
#  except variables prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# mock (default) | live
#   mock: demo adapters, except streams whose provider is set explicitly or whose API key is present
#   live: "auto" streams also use keyless live providers (Coinbase WS, RSS, Cboe, ForexFactory, public crypto metrics)
PULSE_MODE=mock

# ── Provider selection (auto = choose from the keys present / PULSE_MODE) ─────────
# CRYPTO_PROVIDER=auto          # mock | coinbase | binance | binanceus
# EQUITY_PROVIDER=auto          # mock | alpaca | finnhub
# FX_PROVIDER=auto              # mock | twelvedata | finnhub
# NEWS_PROVIDERS=auto           # comma list: mock,rss,finnhub,cryptopanic
# CALENDAR_PROVIDER=auto        # mock | forexfactory
# EARNINGS_PROVIDER=auto        # mock | finnhub
# CRYPTO_MARKET_PROVIDER=auto   # mock | public   (alternative.me + CoinGecko + OKX funding)
# VOL_PROVIDER=auto             # mock | cboe     (15-minute delayed)
# OPTIONS_PROVIDER=mock         # mock only — no free put/call or unusual-activity feed exists

# ── API keys ──────────────────────────────────────────────────────────────────
# Finnhub (free: 60 req/min, US stock trades over WebSocket, market news, earnings calendar)
FINNHUB_API_KEY=
# Twelve Data (free: 8 credits/min, 800/day → FX is polled; quotes are labeled with their max age)
TWELVEDATA_API_KEY=
# TWELVEDATA_SYMBOLS=EURUSD,GBPUSD,AUDUSD,NZDUSD,USDCAD,USDCHF,USDJPY
# TWELVEDATA_DAILY_CREDITS=800
# Alpaca (free Basic plan: real-time IEX-only trades over WebSocket)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# ALPACA_FEED=iex               # sip requires a paid Alpaca data plan
# CryptoPanic (free developer tier was discontinued in 2026 — paid key required)
CRYPTOPANIC_API_KEY=
# Anthropic — optional AI TL;DR + "why it matters" per high-impact cluster
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # set claude-haiku-4-5 for the lowest cost
# AI_MIN_IMPACT=50
# AI_MAX_PER_HOUR=40

# ── Delay labels (set if your plan is delayed, so the UI never shows it as live) ──
# EQUITY_DELAY_MINUTES=0
# FX_DELAY_MINUTES=0

# ── News pipeline ─────────────────────────────────────────────────────────────
# BREAKING_THRESHOLD=75
# NEWS_RETENTION_DAYS=7
# RSS_POLL_SECONDS=60
# RSS_FEEDS=Federal Reserve|fed|https://www.federalreserve.gov/feeds/press_all.xml,SEC|sec|https://www.sec.gov/news/pressreleases.rss
# SEC asks automated clients to identify themselves:
# SEC_USER_AGENT=PulseTerminal/0.1 (you@example.com)
# FINNHUB_NEWS_POLL_SECONDS=60
# MOCK_NEWS_RATE=1              # demo headline rate multiplier

# ── Worker ────────────────────────────────────────────────────────────────────
# PULSE_WORKER_PORT=4000        # (PORT also honoured, e.g. on Fly/Railway)
# PULSE_WORKER_HOST=0.0.0.0
# DATABASE_PATH=./data/pulse.db
# CORS_ORIGIN=*                 # comma list of allowed browser origins for the WebSocket/API

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
# Where Next proxies /api/* (read at build time for rewrites)
# PULSE_WORKER_URL=http://127.0.0.1:4000
# Browser WebSocket URL. Default: ws(s)://<page host>:4000/ws
# NEXT_PUBLIC_WS_URL=wss://pulse-worker.fly.dev/ws
