# Memecoin Radar — every key is OPTIONAL. Phase 1 runs with zero keys.
# You can also paste keys on the Connectors page instead (encrypted at rest in data/).
# Never put a private key or seed phrase anywhere in this app.

# Encryption secret for keys saved via the UI (otherwise data/secret.key is generated)
RADAR_SECRET=

# ---- AI (Phase 3+) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Social (Phase 3)
X_BEARER_TOKEN=            # https://developer.x.com/en/portal/dashboard (pay-per-use credits)
TELEGRAM_API_ID=           # https://my.telegram.org/apps
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
REDDIT_CLIENT_ID=          # https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_SECRET=
NEYNAR_API_KEY=            # https://dev.neynar.com (Farcaster)
YOUTUBE_API_KEY=           # https://console.cloud.google.com/apis/library/youtube.googleapis.com

# ---- On-chain / market
HELIUS_API_KEY=            # https://dashboard.helius.dev/signup
BIRDEYE_API_KEY=           # https://bds.birdeye.so
COINGECKO_API_KEY=         # https://www.coingecko.com/en/developers/dashboard (Demo key)

# ---- Alerts (Phase 2)
TELEGRAM_BOT_TOKEN=        # @BotFather -> /newbot
TELEGRAM_CHAT_ID=          # https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot
DISCORD_WEBHOOK_URL=
NTFY_TOPIC=                # https://ntfy.sh — pick a long random topic

# ---- Your public wallet address (read-only, Phase 6)
WALLET_ADDRESS=

# ---- AI spend + models
AI_DAILY_BUDGET_USD=3      # hard daily cap on Claude spend (cost meter in Settings)
# RADAR_FAST_MODEL=claude-haiku-5-5     # post classification
# RADAR_SMART_MODEL=claude-sonnet-5-5   # signal write-ups, daily brief, Ask Radar

# ---- Sources
# GECKO_NETWORKS=solana,base,bsc,eth   # GeckoTerminal trending networks
# RADAR_DISABLE_FIREHOSE=1             # turn off the Bluesky firehose + 4chan /biz/ readers
# RADAR_ENABLE_FIXTURES=1              # ONLY for the FLASH latency test (simulated VIP post endpoint)

# ---- Tuning (defaults sit below each free API's published limit)
# DEX_PAIRS_RPM=240  DEX_PROFILES_RPM=50  GECKO_RPM=25  RUGCHECK_RPM=30
# TIER0_EVERY=3 TIER1_EVERY=6 TIER2_EVERY=15 TIER3_EVERY=60   (seconds per priority tier)
# LAUNCH_TRACK_MINUTES=30  HOT_TRACK_HOURS=6  MAX_TRADE_SUBS=60  RETENTION_HOURS=72
